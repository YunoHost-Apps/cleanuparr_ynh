[Unit]
Description=Cleanuparr - advanced download manager for the Servarr ecosystem
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/Cleanuparr
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=PORT=__PORT__
Environment=BIND_ADDRESS=127.0.0.1
Environment=BASE_PATH=__PATH__
Environment=CLEANUPARR_CONFIG_PATH=__DATA_DIR__
Environment=CLEANUPARR_LOGS_PATH=__DATA_DIR__/logs
Environment=HOME=__DATA_DIR__
Environment=PATH=__DATA_DIR__/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

StandardOutput=append:/var/log/__APP__/__APP__.log
StandardError=inherit

# Basic service hardening. Cleanuparr only writes its YunoHost data directory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
