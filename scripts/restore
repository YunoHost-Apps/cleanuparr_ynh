#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESTORE APP AND DATA
#=================================================
ynh_script_progression "Restoring Cleanuparr app files..."
ynh_restore "$install_dir"
ynh_restore "$data_dir"
chown -R "$app:$app" "$install_dir" "$data_dir"
chmod 755 "$install_dir/Cleanuparr"

# A backup created before Apprise was introduced may not contain the venv.
install_apprise

#=================================================
# RESTORE SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Restoring Cleanuparr system configuration..."

ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_restore "/etc/systemd/system/$app.service"
systemctl enable "$app.service" --quiet

yunohost service add "$app" \
    --description="Advanced download manager for the Servarr ecosystem" \
    --log="/var/log/$app/$app.log"

ynh_restore "/etc/logrotate.d/$app"
ynh_restore "/var/log/$app/"

#=================================================
# START SERVICES
#=================================================
ynh_script_progression "Starting Cleanuparr and reloading NGINX..."
ynh_systemctl --service="$app" --action="start" \
    --log_path="/var/log/$app/$app.log" \
    --wait_until="Application started"
ynh_systemctl --service=nginx --action="reload"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Restoration completed for $app"
